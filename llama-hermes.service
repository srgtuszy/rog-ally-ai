[Unit]
Description=LLM Server (Hermes 3 tool calling - ROCm)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/gpu-setup
Environment="HIP_VISIBLE_DEVICES=0"
Environment="LD_LIBRARY_PATH=%h/gpu-setup/bin:%h/gpu-setup/rocm7-libs"
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep:handle-lid-switch --who="llama-hermes" --why="LLM inference server running" --mode=block %h/gpu-setup/start-hermes.sh
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

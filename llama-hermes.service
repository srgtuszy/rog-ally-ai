[Unit]
Description=LLM Server (Hermes 3 tool calling)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/gpu-setup
Environment="ROCR_VISIBLE_DEVICES=1"
Environment="LD_LIBRARY_PATH=%h/gpu-setup/bin:%h/gpu-setup/rocm7-libs:/usr/lib64"
ExecStart=%h/gpu-setup/llama-server-rocm2 \
    -m %h/gpu-setup/data/models/Hermes-3-8B.Q4_K_M.gguf \
    -ngl 99 \
    -c 65536 \
    --port 8002 \
    --jinja \
    --no-warmup
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
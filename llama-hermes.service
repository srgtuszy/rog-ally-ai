[Unit]
Description=LLM Server (Hermes 3 tool calling - ROCm)
After=network.target

[Service]
Type=simple
User=srgtuszy
WorkingDirectory=/var/home/srgtuszy/gpu-setup
Environment="HIP_VISIBLE_DEVICES=1"
Environment="LD_LIBRARY_PATH=/var/home/srgtuszy/gpu-setup/bin:/var/home/srgtuszy/gpu-setup/rocm7-libs:/usr/lib64"
ExecStart=/var/home/srgtuszy/gpu-setup/llama-server-rocm2 \
    -m /var/home/srgtuszy/gpu-setup/data/models/Hermes-3-8B.Q4_K_M.gguf \
    -ngl 99 \
    -c 262144 \
    -ctk q4_0 \
    -ctv q4_0 \
    --port 8002 \
    --jinja \
    --no-warmup
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target